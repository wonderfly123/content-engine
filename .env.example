# ─────────────────────────────────────────────────────────────────────────────
# Content Engine: environment variables (template)
# Copy to .env.local for development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── APP ACCESS ────────────────────────────────────────────────────────────────
# Who can open the app, and the shared secret the scheduled jobs send.
# Browser login for the whole app (replaced by sign-in once Supabase auth lands)
BASIC_AUTH_USER=jordan
BASIC_AUTH_PASSWORD=change-me
# Sent as `Authorization: Bearer …` by Vercel Cron and by `npm run cron:local`
CRON_SECRET=generate-with-openssl-rand-hex-32

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Supabase Postgres. Use the Session pooler string (dashboard > Connect > Session pooler).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 64 hex chars. Encrypts stored account tokens. Changing it makes existing connections unreadable.
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ── FILE STORAGE ──────────────────────────────────────────────────────────────
# Vercel Blob store `content-engine-media` (public). Hosts finished videos so Instagram can fetch them.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_…

# ── META (INSTAGRAM + FACEBOOK) ───────────────────────────────────────────────
# Meta developer app "Content Engine". Needed for the in-app Connect flow and token refresh.
# Account tokens themselves live encrypted in the database, not here.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback

# ── AI AND RESEARCH ───────────────────────────────────────────────────────────
# Used by the content pipeline (research, briefs, drafts).
# Claude API
ANTHROPIC_API_KEY=sk-ant-…
# Site scraping and search
FIRECRAWL_API_KEY=fc-…
# Competitor and inspiration post scraping
APIFY_TOKEN=apify_api_…

# ── SUPABASE ──────────────────────────────────────────────────────────────
# URL and publishable key are safe for the browser; the secret key is server-only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
SUPABASE_SECRET_KEY=sb_secret_…
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── LOCAL VIDEO PIPELINE (optional) ──────────────────────────────────────────
# Where the video skill keeps its jobs. Default: ~/Desktop/ai-video-editing/jobs
# VIDEO_JOBS_DIR=
# Where `npm run cron:local` finds the running app. Default: http://localhost:3000
# LOCAL_APP_URL=
