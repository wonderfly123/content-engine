# ─────────────────────────────────────────────────────────────────────────────
# Content Engine — environment variables
# Copy to .env.local for development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres connection string (pooled URL recommended for serverless)
DATABASE_URL=

# HTTP Basic Auth (single-user app — edge middleware gates everything)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# 32-byte hex (64 hex chars) key for AES-256-GCM encrypting OAuth tokens
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Anthropic Claude API key (default LLM provider)
ANTHROPIC_API_KEY=

# Firecrawl API key (site scraping + SERP search)
FIRECRAWL_API_KEY=

# Apify API token (competitor/inspiration IG post scraping)
APIFY_TOKEN=

# Meta Graph API OAuth (Instagram + Facebook publishing)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Vercel Blob storage (direct browser uploads via signed URLs)
BLOB_READ_WRITE_TOKEN=

# Shared secret for Vercel Cron handlers (sent as Authorization header)
CRON_SECRET=
